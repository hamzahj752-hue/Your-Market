# =============================================================================
# YourMarket environment variables — EXAMPLE / TEMPLATE
# =============================================================================
# Copy this file to `.env.local` for local development, or set these variables
# in your hosting provider's environment for production.
#
# ⚠️ NEVER commit real values. This file contains NAMES and safe placeholders only.
# ⚠️ Only `NEXT_PUBLIC_*` variables are safe to ship to the browser. Any variable
#    without the `NEXT_PUBLIC_` prefix stays server-side only.
# ⚠️ Do NOT put the Supabase service-role key or any payment secret in a
#    NEXT_PUBLIC_* variable or in browser code.

# --- Supabase (public / browser-safe) -----------------------------------------
# Project URL from Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon key (safe to expose; NEVER use the service-role key here).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Site / SEO ---------------------------------------------------------------
# Canonical production URL used by metadata, sitemap.xml, robots.txt, the Google
# Merchant Center feed (g:link / g:id) and canonical product links.
# ⚠️ MUST be the real public production domain, e.g. https://yourdomain.com
#    (no trailing slash). Used to build every canonical product URL and the
#    merchant feed, so it must match the live site exactly or Google will reject
#    the sitemap/feed and drop duplicate canonical signals.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# --- Optional: analytics (only if you integrate them) --------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Placeholders the scaffolder lists; unused by the core storefront ----------
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# PERPLEXITY_API_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_ADSENSE_ID=
